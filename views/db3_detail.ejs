<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>選手詳細</title>
</head>
<body>
  <h1>選手詳細</h1>

  <table border="1">
    <tr>
      <th>ID</th>
      <td><%= data.id %></td>
    </tr>
    <tr>
      <th>ポジション</th>
      <td><%= data.position %></td>
    </tr>
    <tr>
      <th>選手名</th>
      <td><%= data.name %></td>
    </tr>
    <tr>
      <th>所属クラブ</th>
      <td><%= data.club %></td>
    </tr>
    <tr>
      <th>出身国</th>
      <td><%= data.country %></td>
    </tr>
    <tr>
      <th>利き足</th>
      <td><%= data.foot %></td>
    </tr>
  </table>

  <p><a href="/soccerplayers">選手一覧に戻る</a></p>
</body>
</html>