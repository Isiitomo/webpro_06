<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>広島東洋カープ歴代最強</title>
</head>
<body>
  <h1>広島東洋カープ歴代最強</h1>

  <table border="1">
    <tr>
      <th>ID</th>
      <th>ポジション</th>
      <th>選手名</th>
    </tr>

    <% for (let item of data) { %>
      <tr>
        <td><%= item.id %></td>
        <td><%= item.position %></td>
        <td>
          <a href="/baseballplayers/<%= item.id %>"><%= item.name %></a>
        </td>
      </tr>
    <% } %>
  </table>
</body>
</html>